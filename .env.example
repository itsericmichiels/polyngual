# Public URL of the site, used for canonical links, hreflang and email links.
NEXT_PUBLIC_SITE_URL=https://polyngual.app

# Resend: API key and the ID of the "Polyngual waitlist" segment.
# Without RESEND_API_KEY the form still works locally and only logs signups to the console.
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# Sender (must be on the domain verified in Resend) and the inbox that receives replies.
WAITLIST_FROM_EMAIL=hello@polyngual.app
WAITLIST_FROM_NAME=Polyngual
WAITLIST_REPLY_TO=polyngualapp@gmail.com

# Optional: GoHighLevel CRM. Private Integration token and Location ID of the Polyngual sub-account.
# Without them signups are only stored in Resend.
GHL_TOKEN=
GHL_LOCATION_ID=

# Long random string. Signs the unsubscribe links in emails.
WAITLIST_SECRET=

# Where the exam pages' "Take the free mock test" buttons go (the app's mock test signup). Unset: the waitlist form.
NEXT_PUBLIC_MOCK_TEST_URL=

# Optional: Google Tag Manager container ("GTM-XXXXXXX") and Google Analytics 4 measurement ID ("G-XXXXXXXXXX").
# Both load only after the visitor accepts the cookie notice. With neither set there is no notice and no Google script.
# If GA4 is configured inside the GTM container, set only NEXT_PUBLIC_GTM_ID so visits are not counted twice.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
