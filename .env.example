# Public URL of the site, used for canonical links, hreflang and email links.
NEXT_PUBLIC_SITE_URL=https://polyngual.com

# Brevo (free tier): API key, the waitlist list ID, and the sender/reply-to inboxes.
# Without BREVO_API_KEY the form still works locally and only logs signups to the console.
BREVO_API_KEY=
BREVO_LIST_ID=
WAITLIST_FROM_EMAIL=eric@polyngual.com
WAITLIST_FROM_NAME=Eric de Polyngual
WAITLIST_REPLY_TO=hola@polyngual.com

# Long random string. Signs the unsubscribe links in emails.
WAITLIST_SECRET=
